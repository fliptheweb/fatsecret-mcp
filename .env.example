FATSECRET_CLIENT_ID=
FATSECRET_CLIENT_SECRET=
# OAuth 1.0 Consumer Secret (different from Client Secret, see API Keys page)
FATSECRET_CONSUMER_SECRET=

# Docker deployment (docker-compose.yml)
# Time zone for the default "today" of diary dates
TZ=UTC
# Public host name, e.g. 203-0-113-5.sslip.io for a server with only an IP
DOMAIN=
# Long random path segment guarding the endpoint: openssl rand -hex 24
MCP_SECRET=
